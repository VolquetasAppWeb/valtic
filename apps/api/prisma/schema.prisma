generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum TenantStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum DocumentType {
  CC
  CE
  PASSPORT
  NIT
}

enum DriverStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum FleetOwnerType {
  NATURAL_PERSON
  LEGAL_ENTITY
}

enum FleetOwnerStatus {
  ACTIVE
  INACTIVE
}

enum VehicleType {
  DUMP_TRUCK
  DOUBLE_TRAILER
  MINI_DUMP_TRUCK
  TRACTOR_TRAILER
  OTHER
}

enum CapacityUnit {
  TON
  CUBIC_METER
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  PAUSED
  CLOSED
}

enum OperationalSiteType {
  LOAD
  UNLOAD
  BOTH
}

enum OperationalSiteStatus {
  ACTIVE
  INACTIVE
}

enum MaterialStatus {
  ACTIVE
  INACTIVE
}

enum RateType {
  PER_TRIP
  PER_TON
  PER_CUBIC_METER
  PER_KILOMETER
  FIXED
}

enum RateStatus {
  ACTIVE
  EXPIRED
  INACTIVE
}

enum TripStatus {
  DRAFT
  ASSIGNED
  ACCEPTED
  EN_ROUTE_TO_LOAD
  LOADING
  LOADED
  EN_ROUTE_TO_UNLOAD
  UNLOADING
  PENDING_VALIDATION
  COMPLETED
  INCLUDED_IN_SETTLEMENT
  SETTLED
  UNDER_REVIEW
  BLOCKED_BY_INCIDENT
  MANUALLY_CLOSED
  CANCELLED
  REJECTED
}

enum TripEventType {
  CREATED
  ASSIGNED
  ACCEPTED
  STARTED_TO_LOAD
  ARRIVED_AT_LOAD
  LOADING_CONFIRMED
  DEPARTED_TO_UNLOAD
  ARRIVED_AT_UNLOAD
  QR_SCANNED
  VALIDATION_PASSED
  VALIDATION_FAILED
  COMPLETED
  CANCELLED
  MANUALLY_CLOSED
  INCIDENT_REPORTED
  INCIDENT_RESOLVED
  REVIEWED_APPROVED
  REVIEWED_REJECTED
  INCLUDED_IN_SETTLEMENT
  SETTLED
  COMPENSATION
}

enum TripEventSource {
  ADMIN
  DISPATCHER
  DRIVER_APP
  SYSTEM
  QR_VALIDATION
}

enum CheckpointQrStatus {
  ACTIVE
  USED
  EXPIRED
  REVOKED
}

enum IncidentType {
  MECHANICAL_FAILURE
  TRAFFIC_ACCIDENT
  DELAY
  WEATHER
  SECURITY
  CARGO_ISSUE
  ROAD_CLOSURE
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

enum EvidenceType {
  PHOTO
  DOCUMENT
  OTHER
}

// Distingue las fotos que trae el registro automatico de vehiculo (tarjeta
// de propiedad frente/reverso, foto de la volqueta) de subidas sueltas
// posteriores (OTHER) — sirve para agrupar/etiquetar las fotos en la vista
// "Ver informacion" del vehiculo.
enum VehicleDocumentKind {
  REGISTRATION_FRONT
  REGISTRATION_BACK
  VEHICLE_PHOTO
  OTHER
}

enum SettlementStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

enum SettlementAdjustmentType {
  BONUS
  DEDUCTION
  CORRECTION
}

// ---------------------------------------------------------------------------
// TENANCY, USERS, RBAC
// ---------------------------------------------------------------------------

model Tenant {
  id        String       @id @default(uuid())
  name      String
  legalName String
  taxId     String
  status    TenantStatus @default(ACTIVE)
  logoUrl   String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users              User[]
  roles              Role[]
  drivers            Driver[]
  fleetOwners        FleetOwner[]
  vehicles           Vehicle[]
  vehicleDocuments   VehicleDocument[]
  driverDocuments    DriverDocument[]
  assignments        DriverVehicleAssignment[]
  projects           Project[]
  operationalSites   OperationalSite[]
  materials          Material[]
  rates              Rate[]
  trips              Trip[]
  tripEvents         TripEvent[]
  locationPoints     LocationPoint[]
  checkpointQrs      CheckpointQr[]
  incidents          Incident[]
  evidences          Evidence[]
  settlements        Settlement[]
  auditEvents        AuditEvent[]

  @@index([taxId])
}

model User {
  id           String     @id @default(uuid())
  tenantId     String?
  firstName    String
  lastName     String
  email        String
  passwordHash String
  phone        String?
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  userRoles         UserRole[]
  driverProfile     Driver?
  fleetOwnerProfile FleetOwner?
  refreshTokens     RefreshToken[]
  auditEvents       AuditEvent[]      @relation("AuditActor")
  createdTrips      Trip[]            @relation("TripCreatedBy")
  resolvedIncidents Incident[]        @relation("IncidentResolvedBy")
  uploadedEvidences Evidence[]        @relation("EvidenceUploadedBy")
  approvedSettlements Settlement[]    @relation("SettlementApprovedBy")
  createdAdjustments SettlementAdjustment[] @relation("AdjustmentCreatedBy")
  managedDrivers      Driver[]        @relation("DispatcherDrivers")
  managedVehicles     Vehicle[]       @relation("DispatcherVehicles")
  managedProjects     Project[]       @relation("DispatcherProjects")
  managedFleetOwners  FleetOwner[]    @relation("DispatcherFleetOwners")
  managedRates        Rate[]          @relation("DispatcherRates")
  uploadedVehicleDocuments VehicleDocument[] @relation("VehicleDocumentUploadedBy")
  uploadedDriverDocuments DriverDocument[] @relation("DriverDocumentUploadedBy")
  deletedDrivers      Driver[]        @relation("DriverDeletedBy")
  deletedVehicles     Vehicle[]       @relation("VehicleDeletedBy")
  deletedProjects     Project[]       @relation("ProjectDeletedBy")
  deletedOperationalSites OperationalSite[] @relation("OperationalSiteDeletedBy")
  deletedRates        Rate[]          @relation("RateDeletedBy")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([passwordResetTokenHash])
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String
  deviceId   String?
  userAgent  String?
  ipAddress  String?
  revokedAt  DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Sesiones de conductor: separadas de RefreshToken porque un Driver no
// siempre tiene un User asociado (Driver.userId es opcional).
model DriverRefreshToken {
  id        String    @id @default(uuid())
  driverId  String
  tokenHash String
  deviceId  String?
  userAgent String?
  ipAddress String?
  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
}

model Role {
  id          String  @id @default(uuid())
  tenantId    String?
  name        String
  description String?

  tenant          Tenant?          @relation(fields: [tenantId], references: [id])
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Permission {
  id          String @id @default(uuid())
  key         String @unique
  description String?

  rolePermissions RolePermission[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// ---------------------------------------------------------------------------
// DRIVERS, FLEET, VEHICLES
// ---------------------------------------------------------------------------

model Driver {
  id                 String       @id @default(uuid())
  tenantId           String
  userId             String?      @unique
  documentType       DocumentType
  documentNumber     String
  firstName          String
  lastName           String
  pinHash            String
  // PIN cifrado (no el hash de argon2, irreversible) para poder mostrarlo
  // de nuevo despues de creado — nullable porque conductores anteriores a
  // este campo no lo tienen (solo se puede "Restablecer PIN" para ellos).
  pinEncrypted       String?
  pinFailedAttempts  Int          @default(0)
  pinLockedUntil     DateTime?
  lastLoginAt        DateTime?
  licenseNumber      String
  // Codigos de categoria autorizados, unidos por coma (ej. "B2, C2") —
  // derivado de licenseCategories, sirve para busqueda/listado rapido sin
  // tener que parsear el JSON.
  licenseCategory    String?
  // Vigencia mas proxima entre todas las categorias autorizadas (la fecha
  // en que hay que estar pendiente de renovar) — derivado de
  // licenseCategories al crear/editar el conductor.
  licenseExpiration  DateTime
  // Cada categoria autorizada tiene su PROPIA vigencia y servicio (ej. "B2"
  // vigente hasta 2034 para uso particular, "C2" vigente hasta 2027 para
  // uso publico) — se guarda la tabla completa tal como viene de la
  // licencia para poder mostrarla igual y para el chequeo de compatibilidad
  // al asignar un vehiculo (ver DriverVehicleAssignmentsService).
  // Forma: Array<{ category, vehicleClass, expiration, serviceType }>
  licenseCategories  Json?

  // Resto de campos leidos de la cedula y la licencia de conduccion (frente
  // y reverso de ambas) — todos opcionales y en texto libre, vienen de OCR
  // best-effort igual que los campos extra de Vehicle. Se autocompletan con
  // el registro con IA; el usuario los puede corregir despues editando.
  country                String? // Pais (cedula)
  nationality            String?
  height                 String? // Estatura
  sex                    String?
  birthDate              String? // Fecha de nacimiento
  bloodType              String? // G.S. / Sangre-RH
  birthPlace             String? // Lugar de nacimiento
  issuePlace             String? // Fecha y lugar de expedicion (cedula)
  documentExpirationDate String? // Fecha de expiracion/vencimiento de la cedula
  supportNumber          String? // Numero de soporte/serie (reverso cedula)
  mrz                    String? // Codigo de lectura mecanica (reverso cedula), si trae
  licenseIssuingAuthority String? // Organismo de transito expedidor (licencia)
  licenseRestrictions    String? // Restricciones del conductor (licencia)
  licenseIssueDate       String? // Fecha de expedicion de la licencia

  status             DriverStatus @default(ACTIVE)
  // Dispatcher "dueno" del conductor: null si lo creo un TENANT_ADMIN (dato
  // compartido/administrativo). Un DISPATCHER solo ve/gestiona los suyos.
  // Mismo patron que Vehicle.dispatcherId: ademas de scopear visibilidad,
  // tambien scopea unicidad de documentNumber (ver @@unique abajo) — dos
  // DISPATCHER distintos pueden registrar el mismo conductor real (mismo
  // numero de documento, cada uno con su propio PIN) cada uno en su propia
  // cuenta, sin verse entre si. AuthService.driverLogin revisa todas las
  // filas que compartan documento e identifica la correcta por PIN.
  dispatcherId       String?
  // Soft-delete: un DISPATCHER puede eliminar sus propios conductores, pero
  // la fila nunca se borra fisicamente — queda excluida de las consultas
  // normales (deletedAt: null) y visible solo para TENANT_ADMIN via el
  // historial (GET /drivers/deleted), ademas de quedar en AuditEvent.
  deletedAt          DateTime?
  deletedById        String?
  deleteReason       String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  tenant     Tenant @relation(fields: [tenantId], references: [id])
  user       User?  @relation(fields: [userId], references: [id])
  dispatcher User?  @relation("DispatcherDrivers", fields: [dispatcherId], references: [id])
  deletedBy  User?  @relation("DriverDeletedBy", fields: [deletedById], references: [id])

  assignments    DriverVehicleAssignment[]
  trips          Trip[]
  tripEvents     TripEvent[]
  locationPoints LocationPoint[]
  incidents      Incident[]
  refreshTokens  DriverRefreshToken[]
  uploadedEvidences Evidence[] @relation("EvidenceUploadedByDriver")
  auditEvents    AuditEvent[] @relation("AuditActorDriver")
  documents      DriverDocument[]

  // Postgres no considera dos NULL iguales para efectos de un unique
  // constraint, asi que esto por si solo NO evita documentos duplicados
  // entre conductores creados por un TENANT_ADMIN (dispatcherId null) — ese
  // caso sigue revalidandose a mano en DriversService.create.
  @@unique([tenantId, dispatcherId, documentNumber])
  @@index([tenantId, status])
  @@index([tenantId, dispatcherId])
  @@index([tenantId, deletedAt])
}

// Distingue las fotos del registro automatico de conductor (cedula
// frente/reverso, licencia frente/reverso) de subidas sueltas posteriores
// (OTHER) — mismo patron que VehicleDocumentKind.
enum DriverDocumentKind {
  CEDULA_FRONT
  CEDULA_BACK
  LICENSE_FRONT
  LICENSE_BACK
  OTHER
}

model DriverDocument {
  id           String   @id @default(uuid())
  tenantId     String
  driverId     String
  fileUrl      String
  fileName     String
  mimeType     String
  fileSize     Int
  uploadedById String?
  kind         DriverDocumentKind @default(OTHER)
  createdAt    DateTime @default(now())

  tenant     Tenant @relation(fields: [tenantId], references: [id])
  driver     Driver @relation(fields: [driverId], references: [id])
  uploadedBy User?  @relation("DriverDocumentUploadedBy", fields: [uploadedById], references: [id])

  @@index([tenantId, driverId])
}

model FleetOwner {
  id                  String           @id @default(uuid())
  tenantId            String
  userId              String?          @unique
  type                FleetOwnerType
  documentNumber      String
  name                String
  phone               String
  email                String?
  bankName            String?
  bankAccountType     String?
  bankAccountLastFour String?
  status              FleetOwnerStatus @default(ACTIVE)
  // Dispatcher al que esta asignado este propietario: null si es
  // administrativo/compartido (no visible para ningun DISPATCHER, igual que
  // Driver/Vehicle/Project). Solo TENANT_ADMIN asigna esto al crear/editar.
  dispatcherId        String?

  tenant     Tenant @relation(fields: [tenantId], references: [id])
  user       User?  @relation(fields: [userId], references: [id])
  dispatcher User?  @relation("DispatcherFleetOwners", fields: [dispatcherId], references: [id])

  vehicles    Vehicle[]
  trips       Trip[]
  settlements Settlement[]
  rates       Rate[]

  @@unique([tenantId, documentNumber])
  @@index([tenantId, status])
  @@index([tenantId, dispatcherId])
}

model Vehicle {
  id           String        @id @default(uuid())
  tenantId     String
  fleetOwnerId String
  plate        String
  vehicleType  VehicleType
  // Marca, modelo(linea) y capacidad son opcionales: se pueden completar a
  // mano o autocompletar leyendo la tarjeta de propiedad por OCR (ver
  // VehicleDocument / POST /vehicles/extract-registration).
  brand        String?
  model        String?
  year         Int
  capacity     Decimal?      @db.Decimal(10, 2)
  capacityUnit CapacityUnit?
  // Numero de la tarjeta de propiedad ("LICENCIA DE TRANSITO No"). Sirve
  // como identificador adicional del vehiculo, unico por tenant cuando se
  // conoce; nullable porque no todos los vehiculos existentes lo tienen.
  licenseNumber String?

  // Resto de campos impresos en la tarjeta de propiedad colombiana (frente y
  // reverso) — todos opcionales y en texto libre (no se fuerza un tipo mas
  // estricto, ej. fechas o numeros, porque vienen de OCR best-effort y un
  // formato inesperado no deberia romper el guardado). Se leen automatico
  // en el registro con IA; el usuario los puede corregir despues editando.
  country              String?
  licenseBarcode       String? // Codigo de barras inferior (LIC)
  cc                   String? // Cilindrada
  color                String?
  serviceType          String? // Servicio (particular, publico, etc)
  vehicleClass         String? // Clase de vehiculo (segun la tarjeta, no el VehicleType interno)
  bodyType             String? // Tipo carroceria
  fuelType             String? // Combustible
  loadCapacity         String? // Capacidad (Kg/PSJ) impresa en la tarjeta
  engineNumber         String?
  serialNumber         String?
  vin                  String?
  chassisNumber        String?
  ownerName            String? // Nombre/razon social del propietario impreso en la tarjeta
  ownerDocumentNumber  String? // Identificacion del propietario impresa en la tarjeta
  mobilityRestriction  String?
  armor                String? // Blindaje
  horsepower           String? // Potencia (HP)
  importDeclaration    String?
  importDate           String?
  doors                String?
  propertyLimitation   String?
  registrationDate     String? // Fecha de matricula
  licenseIssueDate     String? // Fecha de expedicion de la licencia de transito
  licenseExpirationDate String? // Fecha de vencimiento
  transitAuthority     String? // Organismo de transito

  status       VehicleStatus @default(ACTIVE)
  // Mismo patron que Driver.dispatcherId: null si lo creo un TENANT_ADMIN.
  // Ademas de scopear visibilidad (ver isDispatcherScoped en el service),
  // ahora tambien scopea unicidad de placa/licencia (ver @@unique abajo):
  // dos DISPATCHER distintos pueden registrar el mismo vehiculo real (misma
  // placa) cada uno en su propia cuenta, sin verse entre si ni chocar.
  dispatcherId String?
  // Soft-delete: mismo patron que Driver — el DISPATCHER elimina solo sus
  // propios vehiculos, pero la fila nunca se borra fisicamente; queda
  // excluida de las consultas normales (deletedAt: null) y visible solo
  // para TENANT_ADMIN via el historial (GET /vehicles/deleted).
  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  fleetOwner FleetOwner @relation(fields: [fleetOwnerId], references: [id])
  dispatcher User?      @relation("DispatcherVehicles", fields: [dispatcherId], references: [id])
  deletedBy  User?      @relation("VehicleDeletedBy", fields: [deletedById], references: [id])

  assignments DriverVehicleAssignment[]
  trips       Trip[]
  incidents   Incident[]
  documents   VehicleDocument[]

  // Postgres no considera dos NULL iguales para efectos de un unique
  // constraint, asi que esto por si solo NO evita placas duplicadas entre
  // vehiculos creados por un TENANT_ADMIN (dispatcherId null) — ese caso
  // sigue revalidandose a mano en VehiclesService.create (ver
  // existingActive/existingLicense), igual que ya se hacia antes de este
  // campo, para no depender de una garantia que la base de datos no da.
  @@unique([tenantId, dispatcherId, plate])
  @@unique([tenantId, dispatcherId, licenseNumber])
  @@index([tenantId, status])
  @@index([tenantId, dispatcherId])
  @@index([tenantId, deletedAt])
}

// Historico de fotos de tarjeta de propiedad subidas para un vehiculo (cada
// vez que se sube una queda un registro nuevo, nunca se sobreescribe).
model VehicleDocument {
  id         String   @id @default(uuid())
  tenantId   String
  vehicleId  String
  fileUrl    String
  fileName   String
  mimeType   String
  fileSize   Int
  uploadedById String?
  // Nullable/default OTHER para no romper filas ya existentes creadas antes
  // de este campo (subidas sueltas via "Ver documentos", sin distincion).
  kind       VehicleDocumentKind @default(OTHER)
  createdAt  DateTime @default(now())

  tenant     Tenant  @relation(fields: [tenantId], references: [id])
  vehicle    Vehicle @relation(fields: [vehicleId], references: [id])
  uploadedBy User?   @relation("VehicleDocumentUploadedBy", fields: [uploadedById], references: [id])

  @@index([tenantId, vehicleId])
}

model DriverVehicleAssignment {
  id        String    @id @default(uuid())
  tenantId  String
  driverId  String
  vehicleId String
  startAt   DateTime  @default(now())
  endAt     DateTime?
  active    Boolean   @default(true)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  driver  Driver  @relation(fields: [driverId], references: [id])
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([tenantId, active])
  @@index([driverId])
  @@index([vehicleId])
}

// ---------------------------------------------------------------------------
// PROJECTS & OPERATIONAL SITES
// ---------------------------------------------------------------------------

model Project {
  id          String        @id @default(uuid())
  tenantId    String
  name        String
  code        String
  description String?
  // Opcional: en el flujo de configuracion automatica el despachador puede
  // no mencionar el cliente y la obra se crea igual.
  clientName  String?
  status      ProjectStatus @default(PLANNED)
  startDate   DateTime
  endDate     DateTime?
  // Mismo patron que Driver.dispatcherId: null si la creo un TENANT_ADMIN.
  dispatcherId String?
  // Soft-delete: al eliminar una obra se marcan tambien (en cascada, a
  // nivel de aplicacion, no de la base de datos) sus puntos operativos y
  // tarifas — nunca se borra la fila fisicamente, para no romper el
  // historial de viajes que las referencian. Eliminar un punto operativo
  // suelto NO afecta a la obra (ver OperationalSitesService.remove).
  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant     Tenant @relation(fields: [tenantId], references: [id])
  dispatcher User?  @relation("DispatcherProjects", fields: [dispatcherId], references: [id])
  deletedBy  User?  @relation("ProjectDeletedBy", fields: [deletedById], references: [id])

  operationalSites OperationalSite[]
  rates            Rate[]
  trips            Trip[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, dispatcherId])
  @@index([tenantId, deletedAt])
}

model OperationalSite {
  id              String                 @id @default(uuid())
  tenantId        String
  projectId       String
  name            String
  type            OperationalSiteType
  address         String
  latitude        Float
  longitude       Float
  geofenceRadius  Int
  status          OperationalSiteStatus  @default(ACTIVE)
  // Soft-delete propio (no depende de si la obra esta o no eliminada) —
  // ver comentario en Project.deletedAt.
  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  project Project @relation(fields: [projectId], references: [id])
  deletedBy User? @relation("OperationalSiteDeletedBy", fields: [deletedById], references: [id])

  ratesAsOrigin      Rate[]         @relation("RateOriginSite")
  ratesAsDestination Rate[]         @relation("RateDestinationSite")
  tripsAsOrigin      Trip[]         @relation("TripOriginSite")
  tripsAsDestination Trip[]         @relation("TripDestinationSite")
  checkpointQrs      CheckpointQr[]

  @@index([tenantId, projectId])
  @@index([tenantId, deletedAt])
}

model Material {
  id       String         @id @default(uuid())
  tenantId String
  name     String
  code     String
  unit     String
  status   MaterialStatus @default(ACTIVE)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  rates  Rate[]
  trips  Trip[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
}

// ---------------------------------------------------------------------------
// RATES
// ---------------------------------------------------------------------------

model Rate {
  id                 String     @id @default(uuid())
  tenantId           String
  projectId          String
  originSiteId       String
  destinationSiteId  String
  materialId         String
  fleetOwnerId       String?
  vehicleType        VehicleType?
  rateType           RateType
  value              Decimal    @db.Decimal(12, 2)
  currency           String     @default("COP")
  validFrom          DateTime
  validUntil         DateTime?
  status             RateStatus @default(ACTIVE)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  // Mismo patron que Driver.dispatcherId: null si la creo un TENANT_ADMIN.
  // Cada DISPATCHER fija sus propias tarifas y solo ve/gestiona las suyas;
  // TENANT_ADMIN ve todas sin restriccion (historico completo del tenant).
  dispatcherId String?
  // Soft-delete propio — ver comentario en Project.deletedAt.
  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  project         Project         @relation(fields: [projectId], references: [id])
  originSite      OperationalSite @relation("RateOriginSite", fields: [originSiteId], references: [id])
  destinationSite OperationalSite @relation("RateDestinationSite", fields: [destinationSiteId], references: [id])
  material        Material        @relation(fields: [materialId], references: [id])
  fleetOwner      FleetOwner?     @relation(fields: [fleetOwnerId], references: [id])
  dispatcher      User?           @relation("DispatcherRates", fields: [dispatcherId], references: [id])
  deletedBy       User?           @relation("RateDeletedBy", fields: [deletedById], references: [id])

  trips Trip[]

  @@index([tenantId, projectId, status])
  @@index([tenantId, originSiteId, destinationSiteId, materialId])
  @@index([tenantId, dispatcherId])
  @@index([tenantId, deletedAt])
}

// ---------------------------------------------------------------------------
// TRIPS
// ---------------------------------------------------------------------------

model Trip {
  id                 String     @id @default(uuid())
  tenantId           String
  sequentialNumber   Int
  projectId          String
  driverId           String
  vehicleId          String
  fleetOwnerId       String
  originSiteId       String
  destinationSiteId  String
  materialId         String
  rateId             String?
  status             TripStatus @default(DRAFT)
  estimatedQuantity  Decimal?   @db.Decimal(10, 2)
  actualQuantity     Decimal?   @db.Decimal(10, 2)
  quantityUnit       CapacityUnit?
  rateSnapshot       Json?
  assignedAt         DateTime?
  acceptedAt         DateTime?
  startedAt          DateTime?
  loadedAt           DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdById        String
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  version            Int        @default(1)
  // Foto del vale fisico (recibo de entrega de material) tomada por el
  // conductor al cerrar el viaje + resultado de OCR sobre esa foto. Los
  // vales no traen valor en pesos, traen cantidad/volumen y numero de vale
  // — eso es lo que se extrae, como referencia para comparar contra la
  // cantidad registrada del viaje, nunca reemplaza ese dato. La foto tambien
  // queda con la fecha/hora y ubicacion GPS de cuando se tomo (no lo que
  // diga el papel), para poder verificar donde y cuando se capturo.
  voucherImageUrl        String?
  voucherRawText         String?
  voucherNumber          String?
  voucherExtractedQuantity Decimal? @db.Decimal(10, 2)
  voucherExtractedUnit   CapacityUnit?
  // Cualquier otro campo con etiqueta que el OCR pudo leer del vale
  // (cliente, obra, placa, conductor, fecha, etc) — { "Placa": "TGN313", ... }.
  voucherExtractedFields Json?
  voucherCapturedAt      DateTime?
  voucherLatitude        Float?
  voucherLongitude       Float?
  voucherUploadedAt      DateTime?

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  project         Project         @relation(fields: [projectId], references: [id])
  driver          Driver          @relation(fields: [driverId], references: [id])
  vehicle         Vehicle         @relation(fields: [vehicleId], references: [id])
  fleetOwner      FleetOwner      @relation(fields: [fleetOwnerId], references: [id])
  originSite      OperationalSite @relation("TripOriginSite", fields: [originSiteId], references: [id])
  destinationSite OperationalSite @relation("TripDestinationSite", fields: [destinationSiteId], references: [id])
  material        Material        @relation(fields: [materialId], references: [id])
  rate            Rate?           @relation(fields: [rateId], references: [id])
  createdBy       User            @relation("TripCreatedBy", fields: [createdById], references: [id])

  events          TripEvent[]
  locationPoints  LocationPoint[]
  incidents       Incident[]
  evidences       Evidence[]
  settlementItems SettlementItem[]

  @@unique([tenantId, sequentialNumber])
  @@index([tenantId, status])
  @@index([tenantId, driverId])
  @@index([tenantId, vehicleId])
  @@index([tenantId, fleetOwnerId])
  @@index([tenantId, projectId])
}

// Cadena de eventos append-only por viaje (integridad via eventHash encadenado).
model TripEvent {
  id               String           @id @default(uuid())
  tenantId         String
  tripId           String
  type             TripEventType
  source           TripEventSource
  actorUserId      String?
  driverId         String?
  deviceId         String?
  latitude         Float?
  longitude        Float?
  accuracy         Float?
  payload          Json
  previousHash     String?
  eventHash        String
  occurredAt       DateTime
  receivedAt       DateTime         @default(now())
  createdAt        DateTime         @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  trip   Trip    @relation(fields: [tripId], references: [id])
  driver Driver? @relation(fields: [driverId], references: [id])

  locationPoints LocationPoint[]

  @@index([tenantId, tripId, createdAt])
}

model LocationPoint {
  id         String   @id @default(uuid())
  tenantId   String
  tripId     String
  driverId   String
  deviceId   String
  eventId    String   @unique
  latitude   Float
  longitude  Float
  accuracy   Float
  altitude   Float?
  speed      Float?
  heading    Float?
  capturedAt DateTime
  receivedAt DateTime @default(now())

  tripEventId String?

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  trip      Trip       @relation(fields: [tripId], references: [id])
  driver    Driver     @relation(fields: [driverId], references: [id])
  tripEvent TripEvent? @relation(fields: [tripEventId], references: [id])

  @@index([tenantId, tripId, capturedAt])
}

model CheckpointQr {
  id                 String             @id @default(uuid())
  tenantId           String
  operationalSiteId  String
  nonce              String             @unique
  expiresAt          DateTime
  usedAt             DateTime?
  status             CheckpointQrStatus @default(ACTIVE)
  signature          String
  createdAt          DateTime           @default(now())

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  operationalSite OperationalSite @relation(fields: [operationalSiteId], references: [id])

  @@index([tenantId, operationalSiteId, status])
}

// ---------------------------------------------------------------------------
// INCIDENTS & EVIDENCE
// ---------------------------------------------------------------------------

model Incident {
  id               String           @id @default(uuid())
  tenantId         String
  tripId           String?
  driverId         String
  vehicleId        String?
  type             IncidentType
  severity         IncidentSeverity
  description      String
  latitude         Float?
  longitude        Float?
  status           IncidentStatus   @default(OPEN)
  reportedAt       DateTime         @default(now())
  resolvedAt       DateTime?
  resolvedById     String?
  resolutionNotes  String?

  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  trip       Trip?    @relation(fields: [tripId], references: [id])
  driver     Driver   @relation(fields: [driverId], references: [id])
  vehicle    Vehicle? @relation(fields: [vehicleId], references: [id])
  resolvedBy User?    @relation("IncidentResolvedBy", fields: [resolvedById], references: [id])

  evidences Evidence[]

  @@index([tenantId, status, severity])
  @@index([tenantId, tripId])
}

model Evidence {
  id           String       @id @default(uuid())
  tenantId     String
  tripId       String?
  incidentId   String?
  type         EvidenceType
  fileUrl      String
  fileName     String
  mimeType     String
  fileSize     Int
  // Quien subio el archivo puede ser un usuario administrativo o un
  // conductor sin cuenta de User asociada; exactamente uno de los dos se
  // llena (mismo patron que TripEvent.actorUserId/driverId).
  uploadedById       String?
  uploadedByDriverId String?
  createdAt          DateTime     @default(now())

  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  trip             Trip?     @relation(fields: [tripId], references: [id])
  incident         Incident? @relation(fields: [incidentId], references: [id])
  uploadedBy       User?     @relation("EvidenceUploadedBy", fields: [uploadedById], references: [id])
  uploadedByDriver Driver?   @relation("EvidenceUploadedByDriver", fields: [uploadedByDriverId], references: [id])

  @@index([tenantId, tripId])
  @@index([tenantId, incidentId])
}

// ---------------------------------------------------------------------------
// SETTLEMENTS
// ---------------------------------------------------------------------------

model Settlement {
  id               String           @id @default(uuid())
  tenantId         String
  sequentialNumber Int
  fleetOwnerId     String
  periodStart      DateTime
  periodEnd        DateTime
  status           SettlementStatus @default(DRAFT)
  subtotal         Decimal          @db.Decimal(14, 2)
  adjustmentsTotal Decimal          @default(0) @db.Decimal(14, 2)
  total            Decimal          @db.Decimal(14, 2)
  currency         String           @default("COP")
  approvedById     String?
  approvedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  fleetOwner FleetOwner @relation(fields: [fleetOwnerId], references: [id])
  approvedBy User?      @relation("SettlementApprovedBy", fields: [approvedById], references: [id])

  items       SettlementItem[]
  adjustments SettlementAdjustment[]

  @@unique([tenantId, sequentialNumber])
  @@index([tenantId, fleetOwnerId, status])
}

model SettlementItem {
  id           String   @id @default(uuid())
  settlementId String
  tripId       String
  rateType     RateType
  quantity     Decimal  @db.Decimal(10, 2)
  unitValue    Decimal  @db.Decimal(12, 2)
  total        Decimal  @db.Decimal(14, 2)
  rateSnapshot Json

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  trip       Trip       @relation(fields: [tripId], references: [id])

  // Un viaje solo puede pertenecer a una liquidacion activa (draft/approved) a la vez.
  @@unique([tripId])
  @@index([settlementId])
}

model SettlementAdjustment {
  id           String                    @id @default(uuid())
  settlementId String
  type         SettlementAdjustmentType
  description  String
  amount       Decimal                   @db.Decimal(14, 2)
  createdById  String
  createdAt    DateTime                  @default(now())

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  createdBy  User       @relation("AdjustmentCreatedBy", fields: [createdById], references: [id])

  @@index([settlementId])
}

// ---------------------------------------------------------------------------
// AUDIT
// ---------------------------------------------------------------------------

model AuditEvent {
  id            String   @id @default(uuid())
  tenantId      String?
  actorUserId   String?
  // Actor cuando la accion la origina un conductor (app movil), ya que
  // Driver es una tabla separada de User y no puede compartir actorUserId.
  actorDriverId String?
  action        String
  entityType    String
  entityId      String
  oldValue      Json?
  newValue      Json?
  reason        String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  tenant      Tenant? @relation(fields: [tenantId], references: [id])
  actor       User?   @relation("AuditActor", fields: [actorUserId], references: [id])
  actorDriver Driver? @relation("AuditActorDriver", fields: [actorDriverId], references: [id])

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@index([actorDriverId])
}
