# ------------------------------------------------------------------
# VALTIC - Variables de entorno de ejemplo
# Copia este archivo como .env en la raiz y ajusta segun tu entorno.
# ------------------------------------------------------------------

# --- General ---
NODE_ENV=development

# --- PostgreSQL ---
# Puerto 5433 por defecto (no 5432) para no chocar con una instalacion nativa de Postgres en el host.
POSTGRES_USER=valtic
POSTGRES_PASSWORD=valtic_dev_password
POSTGRES_DB=valtic
POSTGRES_PORT=5433
DATABASE_URL=postgresql://valtic:valtic_dev_password@localhost:5433/valtic?schema=public

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- API (NestJS) ---
API_PORT=3001
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# JWT
JWT_ACCESS_SECRET=change_this_access_secret_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_REFRESH_EXPIRES_IN=7d

# PIN de conductor
DRIVER_PIN_MAX_ATTEMPTS=5
DRIVER_PIN_LOCK_MINUTES=15
# Clave de 32 bytes (caracteres) exactos para cifrar el PIN y poder
# mostrarlo de nuevo despues (no solo al crear el conductor). En produccion
# generar una propia, ej: openssl rand -hex 32 (y truncar/ajustar a 32 bytes)
DRIVER_PIN_ENCRYPTION_KEY=change_this_32_byte_key_in_prod!!

# Login de administradores (email + password)
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_LOCK_MINUTES=15

# QR
QR_SIGNING_SECRET=change_this_qr_secret_in_production
QR_EXPIRATION_SECONDS=300

# Geocerca / GPS
GEOFENCE_MAX_ACCURACY_METERS=50
GEOFENCE_MAX_LOCATION_AGE_SECONDS=60

# Storage local
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_MAX_FILE_SIZE_MB=10

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Gemini (OCR de cedula, licencia y tarjeta de propiedad) — sacar una key
# gratis en https://aistudio.google.com. Sin esta variable, esos 4 tipos de
# documento quedan sin autocompletar (el usuario llena el formulario a mano).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ------------------------------------------------------------------
# Produccion (ej. Railway) - referencia, no se usa en local
# ------------------------------------------------------------------
# NODE_ENV=production
# PORT se lo inyecta la plataforma automaticamente al servicio api; no hace
# falta declararlo a mano (API_PORT queda como fallback local).
# DATABASE_URL=${{Postgres.DATABASE_URL}}          -> plugin Postgres de Railway
# REDIS_URL=${{Redis.REDIS_URL}}                   -> plugin Redis de Railway
# CORS_ORIGIN=https://${{web.RAILWAY_PUBLIC_DOMAIN}}
# WEB_APP_URL=https://${{web.RAILWAY_PUBLIC_DOMAIN}}
# NEXT_PUBLIC_API_URL=https://${{api.RAILWAY_PUBLIC_DOMAIN}}/api/v1
# JWT_ACCESS_SECRET / JWT_REFRESH_SECRET / QR_SIGNING_SECRET -> generar valores
# unicos y aleatorios en produccion (ej. `openssl rand -hex 32`), nunca los
# de este archivo de ejemplo.
# STORAGE_LOCAL_PATH=./uploads -> requiere un Volume de Railway montado en
# /app/apps/api/uploads para que los archivos sobrevivan a los redeploys.
